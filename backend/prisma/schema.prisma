generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DocumentType {
  SCOPE
  SRS
  SDS
  STP
}

enum RequirementType {
  FR
  NFR
}

enum RequirementPriority {
  HIGH
  MEDIUM
  LOW
}

enum RequirementStatus {
  PROPOSED
  APPROVED
  IMPLEMENTED
  VERIFIED
}

enum DocumentStatus {
  DRAFT
  IN_PROGRESS
  COMPLETE
}

enum SectionStatus {
  EMPTY
  IN_PROGRESS
  COMPLETE
}

enum ValidationSeverity {
  ERROR
  WARNING
  INFO
}

enum RuleCategory {
  C
  Q
  CN
  T
  D
  SEC
}

enum TraceableType {
  BUSINESS_OBJECTIVE
  USE_CASE
  REQUIREMENT
  DOCUMENT_SECTION
  DESIGN_ELEMENT
  TEST_CASE
  CODE_MODULE
}

enum ValidationRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

model User {
  id           String    @id @default(cuid())
  name         String?
  email        String    @unique
  passwordHash String
  projects     Project[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Project {
  id                 String              @id @default(cuid())
  ownerId            String
  profileId          String?
  name               String
  description        String?             @db.Text
  status             String?
  owner              User                @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  profile            ValidationProfile?  @relation(fields: [profileId], references: [id], onDelete: Restrict)
  documents          Document[]
  requirements       Requirement[]
  businessObjectives BusinessObjective[]
  useCases           UseCase[]
  designElements     DesignElement[]
  testCases          TestCase[]
  traceabilityLinks  TraceabilityLink[]
  validationRuns     ValidationRun[]
  activityLogs       ActivityLog[]
  shareTokens        ShareToken[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  // Backs getProjects(ownerId), which orders by createdAt desc.
  @@index([ownerId, createdAt])
}

model ValidationProfile {
  id              String           @id @default(cuid())
  name            String
  code            String           @unique
  description     String           @db.Text
  audience        String           @db.Text
  tone            String
  displayOrder    Int
  isActive        Boolean          @default(true)
  templates       Template[]
  validationRules ValidationRule[]
  projects        Project[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Template {
  id              String            @id @default(cuid())
  profileId       String
  name            String
  code            String            @unique
  documentType    DocumentType
  description     String            @db.Text
  recommendedFor  String            @db.Text
  displayOrder    Int
  isActive        Boolean           @default(true)
  profile         ValidationProfile @relation(fields: [profileId], references: [id], onDelete: Restrict)
  sections        TemplateSection[]
  documents       Document[]
  validationRules ValidationRule[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model TemplateSection {
  id              String            @id @default(cuid())
  templateId      String
  sectionNumber   String
  title           String
  description     String?           @db.Text
  guidanceText    String?           @db.Text
  exampleText     String?           @db.Text
  placeholderText String?           @db.Text
  isRequired      Boolean           @default(false)
  validationTag   String?
  displayOrder    Int
  parentSectionId String?
  template        Template          @relation(fields: [templateId], references: [id], onDelete: Cascade)
  parentSection   TemplateSection?  @relation("TemplateSectionChildren", fields: [parentSectionId], references: [id], onDelete: Restrict)
  childSections   TemplateSection[] @relation("TemplateSectionChildren")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([templateId, sectionNumber])
}

model Document {
  id                String            @id @default(cuid())
  projectId         String
  templateId        String
  title             String
  documentType      DocumentType
  status            DocumentStatus    @default(DRAFT)
  completionPercent Int               @default(0)
  project           Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  template          Template          @relation(fields: [templateId], references: [id], onDelete: Restrict)
  sections          DocumentSection[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([projectId])
}

model DocumentSection {
  id              String        @id @default(cuid())
  documentId      String
  sectionNumber   String
  title           String
  description     String?       @db.Text
  guidanceText    String?       @db.Text
  exampleText     String?       @db.Text
  placeholderText String?       @db.Text
  content         String?       @db.Text
  isRequired      Boolean       @default(false)
  validationTag   String?
  status          SectionStatus @default(EMPTY)
  displayOrder    Int
  document        Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([documentId, sectionNumber])
}

model BusinessObjective {
  id          String   @id @default(cuid())
  projectId   String
  code        String
  title       String
  description String?  @db.Text
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([projectId, code])
}

model UseCase {
  id          String   @id @default(cuid())
  projectId   String
  code        String
  title       String
  description String?  @db.Text
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([projectId, code])
}

model Requirement {
  id                 String               @id @default(cuid())
  projectId          String
  code               String
  type               RequirementType
  title              String
  description        String?              @db.Text
  priority           RequirementPriority?
  status             RequirementStatus    @default(PROPOSED)
  acceptanceCriteria String?              @db.Text
  project            Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@unique([projectId, code])
}

model DesignElement {
  id          String   @id @default(cuid())
  projectId   String
  code        String
  title       String
  description String?  @db.Text
  elementType String?
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([projectId, code])
}

model TestCase {
  id             String   @id @default(cuid())
  projectId      String
  code           String
  title          String
  description    String?  @db.Text
  expectedResult String?  @db.Text
  status         String?
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([projectId, code])
}

model TraceabilityLink {
  id             String        @id @default(cuid())
  projectId      String
  sourceType     TraceableType
  sourceId       String
  targetType     TraceableType
  targetId       String
  linkType       String
  lastVerifiedAt DateTime      @default(now())
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())

  @@unique([projectId, sourceType, sourceId, targetType, targetId, linkType])
}

model ValidationRule {
  id           String             @id @default(cuid())
  profileId    String
  templateId   String?
  ruleCode     String
  ruleName     String
  ruleCategory RuleCategory
  severity     ValidationSeverity
  checkKey     String
  message      String             @db.Text
  suggestedFix String?            @db.Text
  isActive     Boolean            @default(true)
  profile      ValidationProfile  @relation(fields: [profileId], references: [id], onDelete: Restrict)
  template     Template?          @relation(fields: [templateId], references: [id], onDelete: Restrict)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([profileId, ruleCode])
}

model ValidationRun {
  id             String              @id @default(cuid())
  projectId      String
  status         ValidationRunStatus @default(RUNNING)
  readinessScore Int?
  metrics        Json?
  startedAt      DateTime            @default(now())
  completedAt    DateTime?
  project        Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  results        ValidationResult[]

  @@index([projectId])
}

model ValidationResult {
  id              String             @id @default(cuid())
  validationRunId String
  ruleCode        String
  severity        ValidationSeverity
  message         String             @db.Text
  suggestedFix    String?            @db.Text
  targetType      TraceableType?
  targetId        String?
  validationRun   ValidationRun      @relation(fields: [validationRunId], references: [id], onDelete: Cascade)
  createdAt       DateTime           @default(now())

  @@index([validationRunId])
}

model ShareToken {
  id        String    @id @default(cuid())
  token     String    @unique
  projectId String
  expiresAt DateTime
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([projectId])
}

model ActivityLog {
  id         String   @id @default(cuid())
  projectId  String
  actorId    String?
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  // Backs listActivityLogs: filter by project, newest first.
  @@index([projectId, createdAt])
}
